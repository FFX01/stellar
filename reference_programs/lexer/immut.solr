import local::errors;
import local::log;

type State struct {
    todos: []Todo
}
impl State {
    fn nextId(self: State) -> int {
        if self.todos.len() < 1 {
            return 1;
        }
        return max(self.todos.map(fn(t: Todo) -> int: t.id)) + 1;
    }
    fn string(self) -> str: "State";
}

type Todo struct {
    id: int,
    title: str,
    status: Status
}

type Status enum {
    InProgress,
    Done
}

fn addTodo(s: State, t: Todo) -> State {
    return s.with(todos=[...s.todos, t]);
}

fn getTodo(s: State, id: int) -> Todo? {
    return s.todos.find(fn(t: Todo) -> bool: t.id == id);
}

fn completeTodo(s: State, id: int) -> State! {
    var todo = try getTodo(s, id) else {
        return Err(errors.errF("Todo with id: {} not found.", [id]));
    }
    mut idx = -1;
    for i, t in s.todos {
        if t == todo {
            idx = i;
        }
    }
    todo = todo.with(status=Status.Done);
    var state = s.with(
        todos=[...s.todos.head(idx), todo, ...s.todos.tail(idx + 1)]
    );
    return Ok(state);
}

fn markTodoInProgress(s: State, id: int) -> State! {
    var todo = try getTodo(s, id) else {
        return Err(errors.errF("Todo with id: {} not found.", [id]));
    }
    mut idx = -1;
    for i,t in s.todos {
        if t == todo {
            idx = i;
        }
    }
    if idx < 0 {
        return Err(errors.errF("Todo with id: {} not found.", [id]));
    }
    todo = todo.with(status=Status.Done);
    return Ok(
        s.with(
            todos=[...s.todos[:idx], todo, ...s.todos[idx+1:]]
        )
    );
}

fn deleteTodo(s: State, id: int) -> State! {
    var idx = for i, t in s.todos {
        >> if t.id == id {
            >> i;
        } else { continue; }
    }
    if idx.len() == 0 {
        return Err(errors.errF("Todo with id {} not found.", [id]));
    }
    var newS = s.with(
        todos=[...s.todos[:idx[0]], ...s.todos[idx[0]+1:]]
    );
    return Ok(newS);
}

type Action enum {
    Add(title: str),
    Complete(id: int),
    UnComplete(id: int),
    Delete(id: int)
}

fn update(s: State, action: Action) -> State {
    var newS = switch action {
        Action.Add as a => Ok(addTodo(
            s, 
            Todo(id=s.nextId(), title=a.title, status=Status.InProgress)
        )),
        Action.Complete as c => completeTodo(s, c.id),
        Action.UnComplete as u => markTodoInProgress(s, u.id),
        Action.Delete as d => deleteTodo(s, d.id)
    }
    if newS.error() {
        log.error(newS);
        return s;
    }
    return newS.expect("Something went terribly wrong");
}

fn main() {
    var s = State(todos=[]);

    for {
        // var args = io.stdin.input().split(" ");
        var args = ["add", "new title"];  // once i/o is implemented, use above line
        var action = switch args[0] {
            "add" => Action.Add(title=args[1]),
            "q" => { break; }
        }
    }
}

