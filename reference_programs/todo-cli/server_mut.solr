import std::io;
import std::http;

type State object {
    messages: []str
}
impl State {
    pub fn new() -> *State {
        return &State();
    }
    pub fn addMessage(self, msg: str) {
        self.messages = append(self.messages, msg);
    }
}

type ErrorStatus enum {
    Status400,
    Status404,
    Status500
}
impl Error for ErrorStatus {
    fn message(self) -> str {
        return switch self {
            ErrorStatus.Status400 => "Bad request",
            ErrorStatus.Status404 => "Not found",
            ErrorStatus.Status500 => "Internal server error"
        }
    }
    fn status(self) -> int {
        return switch self {
            ErrorStatus.Status400 => 400,
            ErrorStatus.Status404 => 404,
            ErrorStatus.Status500 => 500
        }
    }
}

type Method enum {
    Get,
    Post,
    Put,
    Patch,
    Head,
    Options,
    Delete
}

type Request object {
    pub path: str,
    pub method: Method,
    pub headers: map[str, str],
    pub body: str
}
imple Request {
    pub fn fromRaw(raw: str) -> Result[Request] {
        return try http.parseToRequest(raw);
    }
}


type Response object {
   pub body: str,
   pub headers: map[str, str],
   pub status: int
}
impl Response {
    pub fn raw(self) -> str {
        return "";
    }
    pub fn error(status: ErrorStatus) -> Response {
        return Response(body=status.message(), status=status.status());
    }
    pub fn created() -> Response {
        return Response(status=201);
    }
}

type HandlerF = fn(Request) -> Result[Response];
type HandlerObj {
    path: str,
    methods: []Method,
    func: HandlerF
}
impl HandlerObj {
    pub fn new(path: str, methods: []Method, f: HandlerF) -> *HandlerObj {
        return &HandlerObj(path=path, methods=methods, func=f);
    }
    pub fn matchReq(self, req: Request) bool {
        if self.path == req.path && contains(self.methods, req.method) {
            return true;
        }
        return false;
    }
}

type Server object {
    host: str,
    port: int,
    socket: *io.Socket
    handlers: []*HandlerF
}
impl Server {
    pub fn new(host: str, posrt: int) -> Result[*Server] {
        var s = io.Socket.new(self.host, self.port);
        return &Server(host=host, port=port, socket=s);
    }
    pub fn register(self, methods: []Method, path: str, h: HandlerF) {
        var hobj = HandlerObj.new(path=path, methods=methods, f=h);
        self.handlers = append(self.handlers, hobj);
    }
    pub fn dispatch(self, req: Request) -> Result[Response] {
        for _, h in self.handlers {
            if h.matchRequest(req) {
                return h.func(req);
            }
        }
        return Err(ErrorStatus.Status400);
    }
    pub fn listen(self) -> Result {
        for {
            try {
                var raw = try self.socket.read();
                var req = try Request.fromRaw(raw);
                var resp = try self.dispatch(req);
                self.send(resp.toRaw());
            } else |e| {
                self.send(Response.error(e));
                continue;
            }
        }
    }
}

fn handleAdd(s: *State) -> HandlerF {
    return fn(req: Request) -> Result[Response] {
        var newMessage = try req.json().get("msg") else {
            return Err(StatusError.Status400);
        }
        s.addMessage(newMessage);
        return Ok(Response.created());
    }
}

fn main() {
    var state = State.new();
    var server = Server.new("localhost", 8000);
    server.register([Methods.POST], "/messages", handleAdd(state));
}
