import std::buffer;
import std::strings;
import std::io;
import std::os;

type NameTooLongError object {
    pub lineNum: int,
    traceback: str,
}
impl Error for NameTooLongError {}

type Stringable interface {  // Not tied to this name, but this should be a builtin interface
    fn string(self) -> str
}

pub type Status enum {
    InProgress,
    Done,
    Canceled,
}
impl Stringable for Status {
    fn string(self) -> str {
        return switch self {
            Status.InProgress => "In Progress",
            Status.Done => "Done",
            Status.Canceled => "Canceled",
        }
    }
}

pub type Todo object {
    title: str,
    status: Status,
}
impl Todo {
    fn rename(self: *Todo, name: str) -> Result {
        if len(name) > 256 {
            return NameTooLongError("name needs to be < 256 in length");
        }
        self.title = name;
        return Ok();
    }
}

impl Stringable for Todo {
    fn string(self) -> str {
        return strings.format(
            "{title}: {status}", 
            title=self.title, 
            status=self.status
        );
    }
}

pub type State object {
    items: []*Todo,
}
impl State {
    fn addTodo(self: *State, todo: *Todo) {
        self.items = append(self.items, todo);
    }
    fn getAtIndex(self: State, index: int) -> Maybe[*Todo] {
        return try self.items[index];
    }
    fn count(self: State) -> int {
        return len(self.items);
    }
}
impl Stringable for State {
    fn string(self) -> str {
        var out = buffer.StringBuffer.new();  // type: *buffer.StringBuffer
        for _, t in self.items {
            out.write(t + "\n");  // Works because Todo implements Stringable
        }
        return out.toString();
    }
}

type Action enum {
    Add(title: str),
    List,
    NoOp,
    Exit,
}

type AddError object {}
impl Error for AddError {}

fn actionAdd(state: *State, title: str) -> Result {
    var t = new(Todo);
    try t.rename(title) else |e| {
        return wrap(e, AddError("unable to add todo"));
    }
    state.addTodo(t);
    return Ok();
}

fn actionList(state: *State) {
    print(state);
}

fn actionExit() {
    os.exit(0);
}

fn dispatch(state: *State, action: Action) -> Result {
    switch action {
        Action.Add => { return actionAdd(state, action.title); }
        Action.List => {
            actionList(state);
            return Ok();
        }
        Action.NoOp => { return Ok(); }
        Action.Exit => actionExit(),
    }
}

fn parse(cmd: str) -> Result[Action] {
    var args = strings.split(cmd, " ");
    if len(args) < 1 {
        return Ok(Action.NoOp);
    }
    return switch try args[0] {
        "add" => {
            var title = try args[1] else {
                return Err("you need to provide a title");
            };
            >> Ok(Action.Add(title=title));
        }
        "list" => Ok(Action.List),
        "exit" => Ok(Action.Exit),
        None => Err("Command missing"),
        _ => Err("invalid command"),
    }
}

fn main() {
    var state = new(State);  // `new` builtin returns a ref
    var stdin = new(io.StdIn);
    for {
        var command = try stdin.read();  // errors here should panic since it is unhandled
        var action = try parse(command) else |e| {
            print(e.message);
            continue;
        }
        try dispatch(state, action) else |e| {
            print(e.message);
            continue;
        }
    }
}
