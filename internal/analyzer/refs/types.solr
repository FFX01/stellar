type State struct {
    todos: []Todo,
    count: int
}
impl State {
    fn string(self) -> str: "State";
    fn addTodo(self, name: str) -> State {
        var t = Todo(name=name, status=Status.InProgress);
        return self.with(todos=[...self.todos, t]);
    }
}

type Todo struct {
    pub name: str,
    pub status: Status
}

type Status enum {
    InProgress,
    Done(when: str)
}

type Action enum {
    Add(title: str)
}

type Stringable interface {
    fn string(self) -> str
}

var s = State();

fn update(state: State, action: Action) -> State {
    return switch action {
        Action.Add => state.addTodo(action.name)
    }
}

var s2: State = update(s, Action.Add(title="new"));
