import std::errors;

fn main() -> Action! {
    switch a {
        1 => { return 1; }
        2 => { return 2; },
    }
    var a = switch b {
        1 => 2,
        2 => 3,
        _ => 4,
    }
    return switch c {
        "hello" => "world",
        "world" => {
            >> try list.pop();
        }
    }
    var command = try args.pop() else {
        return errors.ErrF("You need tp provide a command argument");
    }
    return switch command {
        "add" => {
            var title = try args.get(1) else {
                return Err("you need to provide a title");
            };
            >> Ok(Action.Add(title=title));
        }
        "list" => Ok(Action.List),
        "exit" => Ok(Action.Exit),
        _ => errors.ErrF("Invalid command")
    }
}
