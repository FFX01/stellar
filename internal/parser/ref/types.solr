type Handler = fn(Event) -> Action?;
type Handler2[T] = fn(e: Event, v: T) -> Action[T]?;

pub type Store[Tkey, Tvalue] struct {
    pub key: Tkey,
    pub value: Tvalue,
}

impl Store {
    pub fn string(self: Store) -> str: self.key + ": " + self.value;
    fn write(self: Store, s: str) -> Store {
        var newSelf = @self;
        var cut: []str = s.splitN(":", 1);
        newSelf.k = try cut[0] else self.k;
        newSelf.v = try cut[1] else self.v; 
        newSelf.k = "a";
    }
}

type UserId = int;
type Handler[T] = fn(e: Event) -> T;
type Alias = io.http.Reader[io.http.Request];
type Status enum {
    InProgress,
    Done,
}

fn main() {
    var a: Store[str, int] = Store();
    var a = 1 + 2;
}
