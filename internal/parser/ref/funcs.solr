pub fn add(a: int, b: int) -> Result[int] {
    var sum: int = a + b;
    return Ok(sum);
}

pub fn handle[T](arg: T) -> Action {
    return Action(item=arg);
}

fn actionAdd(state: State, title: str) -> State! {
    mut t = Todo();
    t.title = title;
    var lastId = try state.todos.get(-1) else {
        return errors.ErrF("Could not fetch last id!");
    }
    mut newState = @state;
    newState.todos.push(t);
    return Ok(newState);
}


