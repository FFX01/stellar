fn main() {
    // empty
    var a = #();
    // with one value
    var b = #(1);
    // with multiple values
    var c = #(1, "a", 2.5);
    // nested
    var d = #(2, #(1, 2));
    // as type
    var t: (int, str) = #(1, "hello");
    var e: () = #();
    var f: (int) = #(1);
    var g: ((int, str), []float64)? = Some(#(#(1, "x"), [1.5]));
    var h: fn((int, int)) -> (int, str)! = fn(p: (int, int)) -> (int, str)!: Ok(#(1, "a"));
    var i = #(1, 2,);
    var j = f(#(1 + 2, x.y), #());
}

