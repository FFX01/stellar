type State struct {
    count: int,
    user: User
}

fn initState() -> State {
    var user = User(name="tim", age=30, role=Role.Contractor(company="acme"));
    mut s = State(count=1, user=user);
    return s;
}

fn setUser(s: State, name: str, age: int) -> State {
    var newUser = User(name=name, age=age, role=Role.Normal);
    mut newS = @s;
    newS = State(user=newUser);
    newS.user = newUser;
    newS.user.name = "tommy";
    return newS;
}

type Role enum {
    Admin,
    Normal,
    Contractor(company: str)
}

type User struct {
    name: str,
    age: int,
    role: Role
}

fn ifTest(a: int, b: int) -> int {
    if a > 3 {
        var c = a + b;
        return c;
    } else if a > 5 {
        return b;
    } else {
        return 0;
    }
}

fn world() -> str: "World!";
fn derp() -> str: "Derp!";

fn ifTest2(a: str, b: str) -> str {
    if a == "hello" {
        return world();
    } else derp();
    return derp();
}

fn exprIfTest(a: int) -> str {
    var out = if a > 3 { >> 5; } else 6;
    return if out < 10 { >> "yes"; } else "no";
}
