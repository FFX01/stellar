var intLiteral: int = 1;
var intInfix: int = 1 + 2;
var floatLit: float = 1.0;
var floatInfix: float = 1.2 + 3.4;
var strLit: str = "hello";
var strInfix: str = "hello" + " " + "world";
var boolLit: bool = true;
var boolInfix: bool = true or false;

fn add(a: int, b: int) -> int {
    return a + b;
}

var call: int = add(1, 2);

var callWithVariables: int = add(a=intLiteral, b=intInfix);

var callAndLit: int = add(intLiteral, 2) - 4;
